# Kopier til .env og udfyld. .env er gitignoreret og kommer aldrig i repoet.

# Midlertidig vej: kortlivet token (~4 timer). Bruges hvis refresh-token mangler.
EXPO_PUBLIC_DROPBOX_TOKEN=

# Varig vej: refresh-token udloeber aldrig. Appen henter selv nye adgangstokens.
EXPO_PUBLIC_DROPBOX_APP_KEY=
EXPO_PUBLIC_DROPBOX_APP_SECRET=
EXPO_PUBLIC_DROPBOX_REFRESH_TOKEN=
